# ============================================================
# backend/.env.example
# ============================================================
# WHAT IS THIS FILE?
#   This file lists ALL environment variables your backend needs.
#   It does NOT contain real values — it's just a template.
#
# HOW TO USE IT:
#   1. Copy this file:   cp .env.example .env
#   2. Open .env and fill in your actual values
#   3. NEVER commit your real .env file to Git
# ============================================================


# ─────────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────────

# The full connection string for your Neon PostgreSQL database.
# Format: postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Get this from your Neon dashboard → Connection Details → Connection String
DATABASE_URL=postgresql+asyncpg://your_user:your_password@your_host.neon.tech/attrition_db?sslmode=require

# The synchronous version (used by Alembic for migrations)
# Same as above but without the "+asyncpg"
DATABASE_URL_SYNC=postgresql://your_user:your_password@your_host.neon.tech/attrition_db?sslmode=require


# ─────────────────────────────────────────────────────────────
# JWT AUTHENTICATION
# ─────────────────────────────────────────────────────────────

# A long, random secret string used to sign JWT tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# If someone gets this key, they can forge login tokens — keep it SECRET!
JWT_SECRET_KEY=replace_this_with_a_long_random_string_minimum_32_characters

# Algorithm used to sign JWT tokens. HS256 is the standard.
JWT_ALGORITHM=HS256

# How long (in minutes) a login token stays valid before expiring.
# 480 = 8 hours (a full work day)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480


# ─────────────────────────────────────────────────────────────
# APPLICATION SETTINGS
# ─────────────────────────────────────────────────────────────

# The environment your app is running in.
# Use "development" locally, "production" on Render.
APP_ENV=development

# The name shown in API documentation and error messages.
APP_NAME=Attrition Prediction Platform

# Version string (update this when you deploy new features).
APP_VERSION=1.0.0

# The URL of your frontend app. Used in CORS to allow requests.
# Locally this is your Vite dev server. On Render, use your Vercel URL.
FRONTEND_URL=http://localhost:5173


# ─────────────────────────────────────────────────────────────
# ML MODEL
# ─────────────────────────────────────────────────────────────

# Path to the folder where your trained .pkl model files are stored.
# After running ml_pipeline/train.py, move the files here.
ML_MODELS_DIR=app/ml/models

# The default model to use for predictions (options: logistic, tree, forest)
DEFAULT_MODEL=forest


# ─────────────────────────────────────────────────────────────
# FIRST ADMIN USER (created automatically on first startup)
# ─────────────────────────────────────────────────────────────

# These credentials are used to seed the first admin account.
# Change these before deploying to production!
FIRST_ADMIN_EMAIL=admin@company.com
FIRST_ADMIN_PASSWORD=ChangeThisPassword123!
FIRST_ADMIN_NAME=System Admin
