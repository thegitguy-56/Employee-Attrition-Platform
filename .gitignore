# ============================================================
# .gitignore — Root level
# ============================================================
# This file tells Git which files/folders to NEVER commit.
# Why? Because some files contain secrets, are auto-generated,
# or are too large to store in version control.
# ============================================================


# ─────────────────────────────────────────────────────────────
# ENVIRONMENT FILES — contain passwords, secrets, API keys
# ─────────────────────────────────────────────────────────────
.env
.env.local
.env.production
.env.*.local
backend/.env
frontend/.env


# ─────────────────────────────────────────────────────────────
# PYTHON
# ─────────────────────────────────────────────────────────────

# __pycache__ folders are auto-generated bytecode — not needed in Git
**/__pycache__/
**/*.py[cod]
**/*$py.class

# Virtual environments — these are huge and machine-specific
venv/
.venv/
env/
ENV/
backend/venv/
ml_pipeline/venv/

# pytest cache
.pytest_cache/
**/.pytest_cache/

# mypy type checker cache
.mypy_cache/

# Coverage reports
htmlcov/
.coverage
coverage.xml


# ─────────────────────────────────────────────────────────────
# MACHINE LEARNING
# ─────────────────────────────────────────────────────────────

# .pkl files are trained model binaries — they can be 100MB+
# Regenerate them by running train.py instead of committing them
**/*.pkl
**/*.joblib

# Model output folders
ml_pipeline/models/
backend/app/ml/models/*.pkl

# Jupyter notebook checkpoints
.ipynb_checkpoints/
**/.ipynb_checkpoints/


# ─────────────────────────────────────────────────────────────
# DATASET FILES — large CSV/Excel files
# ─────────────────────────────────────────────────────────────
ml_pipeline/data/*.csv
ml_pipeline/data/*.xlsx
ml_pipeline/data/*.zip


# ─────────────────────────────────────────────────────────────
# NODE / FRONTEND
# ─────────────────────────────────────────────────────────────

# node_modules is auto-generated by npm install — never commit it
node_modules/
frontend/node_modules/

# Vite build output
frontend/dist/
frontend/.vite/

# npm/yarn logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*


# ─────────────────────────────────────────────────────────────
# OPERATING SYSTEM FILES
# ─────────────────────────────────────────────────────────────

# macOS
.DS_Store
**/.DS_Store

# Windows
Thumbs.db
desktop.ini

# Linux
*~


# ─────────────────────────────────────────────────────────────
# EDITOR / IDE FILES
# ─────────────────────────────────────────────────────────────

# VS Code workspace settings (optional — some teams commit these)
.vscode/
.idea/
*.swp
*.swo


# ─────────────────────────────────────────────────────────────
# UPLOADS / TEMP FILES
# ─────────────────────────────────────────────────────────────

# Uploaded CSV files from users
backend/uploads/
backend/temp/

# Generated PDF reports
backend/reports/
