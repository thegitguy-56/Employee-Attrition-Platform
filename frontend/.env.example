# ============================================================
# frontend/.env.example
# ============================================================
# WHAT IS THIS FILE?
#   Environment variables for your React (Vite) frontend.
#   In Vite, ALL variables must start with VITE_ to be accessible
#   inside your React code via import.meta.env.VITE_VARIABLE_NAME
#
# HOW TO USE IT:
#   1. Copy this file:   cp .env.example .env
#   2. Open .env and fill in your actual values
#   3. NEVER commit your real .env file to Git
# ============================================================


# ─────────────────────────────────────────────────────────────
# API CONNECTION
# ─────────────────────────────────────────────────────────────

# The base URL of your FastAPI backend.
# Locally: http://localhost:8000
# On Render (after deploy): https://your-app-name.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# The API version prefix — matches your FastAPI router prefix
VITE_API_VERSION=/api/v1


# ─────────────────────────────────────────────────────────────
# APP SETTINGS
# ─────────────────────────────────────────────────────────────

# The name shown in the browser tab and navbar
VITE_APP_NAME=Attrition Predict

# The environment — used to show/hide debug info
VITE_APP_ENV=development
